<Project>

  <!--
    Fonte única da versão do AiShot.

    Todo artefato de distribuição deriva daqui: o assembly (via AiShot.csproj),
    o instalador Inno Setup, o nuspec do Chocolatey e o script de instalação do
    pacote. O fluxo de release lê este arquivo e injeta o valor nos demais, em
    vez de depender de edição manual em cada um.

    Ao publicar uma versão, altere apenas esta propriedade.
  -->
  <PropertyGroup>
    <AiShotVersion>0.1.4</AiShotVersion>
  </PropertyGroup>

  <!--
    Aviso é erro. O projeto compilava com avisos havia tempo (DPI no manifest,
    conflito de assembly do WebView2), e um aviso que ninguém lê deixa de
    sinalizar qualquer coisa. Tratá-los como erro força a decisão no momento em
    que surgem: corrigir a causa, ou silenciar explicitamente com o motivo.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
