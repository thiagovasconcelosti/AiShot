<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AiShot</AssemblyName>
    <RootNamespace>AiShot</RootNamespace>
    <!-- Definida em Directory.Build.props, na raiz do repositório. -->
    <Version>$(AiShotVersion)</Version>
    <!-- Fonte única da configuração de DPI: substitui o que estava no
         app.manifest e a chamada a Application.SetHighDpiMode. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Expõe os tipos internos ao projeto de testes: SelectionGeometry,
       ToolbarLayout, SecretProtector e HttpUtil são internal por design. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AiShot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Assets\Phosphor.ttf" />
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- UI web (React + shadcn) embutida: painel de Configurações -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\web\dist\**\*">
      <LogicalName>webui/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <!--
    O pacote do WebView2 traz a variante WPF junto da WinForms. O aplicativo usa
    apenas a WinForms, e a WPF referencia WindowsBase 5.0 enquanto o runtime
    resolve a 4.0 — conflito que gerava MSB3277 em toda compilação. Remover a
    referência não usada resolve a causa em vez de silenciar o aviso.
  -->
  <Target Name="RemoverWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- Rebuild do bundle web quando o fonte muda (incremental) -->
  <Target Name="BuildWebUI" BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildProjectDirectory)\..\..\web\src\**\*;$(MSBuildProjectDirectory)\..\..\web\index.html;$(MSBuildProjectDirectory)\..\..\web\package.json"
          Outputs="$(MSBuildProjectDirectory)\..\..\web\dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />
  </Target>

</Project>
